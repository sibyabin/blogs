{
  "name": "blogs-nextjs",
  "version": "1.0.0",
  "description": "Data & AI in the Cloud - Learning Recipes Blog",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate-search-index && next build",
    "start": "next start",
    "export:docs": "node scripts/export-to-docs.mjs",
    "lint": "eslint app components lib --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx}\"",
    "migrate-posts": "ts-node scripts/migrate-posts.ts",
    "validate-posts": "ts-node scripts/validate-migration.ts",
    "generate-search-index": "ts-node scripts/generate-search-index.ts",
    "preview": "next build && next start"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "gray-matter": "^4.0.3",
    "lunr": "^2.3.9",
    "next": "^16.1.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/lunr": "^2.3.5",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "rehype-external-links": "^3.0.0",
    "rehype-highlight": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
